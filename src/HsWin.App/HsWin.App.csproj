<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HsWin.Core\HsWin.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <AssemblyName>Hammerspoon (Windows Edition)</AssemblyName>
    <Product>Hammerspoon (Windows Edition)</Product>
    <Title>Hammerspoon (Windows Edition)</Title>
    <Description>Hammerspoon (Windows Edition)</Description>
    <Company>Hammerspoon</Company>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
